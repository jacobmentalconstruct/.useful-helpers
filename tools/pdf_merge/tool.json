{
  "id": "pdf_merge",
  "summary": "Merge PDFs into one output; dry-run-first and confirm-gated.",
  "category": "pdf",
  "authority": "Apply",
  "operates_on": "project",
  "invocation": {
    "interpreter": "${ROOT_VENV_PYTHON}",
    "entry": "tools/pdf_merge/cli.py"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "out": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean",
        "default": true
      },
      "confirm": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "files"
    ]
  },
  "output_shape": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "files": {
        "type": "array"
      },
      "summary": {
        "type": "object"
      }
    }
  }
}
