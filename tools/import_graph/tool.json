{
  "id": "import_graph",
  "summary": "Build a Python import graph with internal edges, external roots, fan-in/fan-out, and cycles.",
  "category": "code-intel",
  "authority": "Observe",
  "operates_on": "project",
  "invocation": {
    "interpreter": "${ROOT_VENV_PYTHON}",
    "entry": "tools/import_graph/cli.py"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "root": {
        "type": "string",
        "description": "workspace-relative root"
      },
      "max_files": {
        "type": "integer",
        "default": 500
      },
      "cycle_limit": {
        "type": "integer",
        "default": 20
      }
    }
  },
  "output_shape": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "summary": {
        "type": "object"
      },
      "internal_edges": {
        "type": "array"
      },
      "external_imports": {
        "type": "array"
      },
      "hotspots": {
        "type": "array"
      },
      "cycles": {
        "type": "array"
      }
    }
  }
}
