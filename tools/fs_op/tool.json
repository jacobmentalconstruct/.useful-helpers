{
  "id": "fs_op",
  "summary": "Governed filesystem mutation: a BATCH of mkdir/touch/copy/move/delete ops (one plan, one approval). Paths confined to the roots.",
  "category": "text",
  "authority": "Apply",
  "operates_on": "project",
  "writes": "target",
  "invocation": {
    "interpreter": "${ROOT_VENV_PYTHON}",
    "entry": "tools/fs_op/cli.py"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "ops": {
        "type": "array",
        "description": "list of ops, each {op: mkdir|touch|copy|move|delete, path: <path>, dest: <path for copy/move>}",
        "items": { "type": "object" }
      },
      "op": { "type": "string", "description": "single-op form: mkdir|touch|copy|move|delete" },
      "path": { "type": "string", "description": "single-op form: the path" },
      "dest": { "type": "string", "description": "single-op form: destination (copy/move)" },
      "apply": { "type": "boolean", "description": "execute the whole batch (else preview the plan)" }
    }
  },
  "output_shape": {
    "type": "object",
    "properties": {
      "ok": { "type": "boolean" },
      "dry_run": { "type": "boolean" },
      "count": { "type": "integer" },
      "plan": { "type": "array" },
      "applied": { "type": "integer" },
      "failed": { "type": "integer" },
      "results": { "type": "array" }
    }
  }
}
