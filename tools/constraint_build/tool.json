{
  "id": "constraint_build",
  "summary": "Extract stable constraint statements from text or workspace-local docs.",
  "category": "prompt-eval",
  "authority": "Observe",
  "operates_on": "project",
  "invocation": {
    "interpreter": "${ROOT_VENV_PYTHON}",
    "entry": "tools/constraint_build/cli.py"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "paths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "prefix": {
        "type": "string",
        "default": "c"
      }
    }
  },
  "output_shape": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "constraints": {
        "type": "array"
      },
      "summary": {
        "type": "object"
      }
    }
  }
}
