{
  "id": "bd_query",
  "summary": "Find lexical/vector anchors in a BD graph DB and return a projected subgraph.",
  "category": "bd-graph",
  "authority": "Observe",
  "operates_on": "project",
  "invocation": {
    "interpreter": "${ROOT_VENV_PYTHON}",
    "entry": "tools/bd_query/cli.py"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "db": {
        "type": "string"
      },
      "query": {
        "type": "string"
      },
      "top_k": {
        "type": "integer",
        "default": 8
      },
      "hops": {
        "type": "integer",
        "default": 1
      }
    },
    "required": [
      "query"
    ]
  },
  "output_shape": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "anchors": {
        "type": "array"
      },
      "graph": {
        "type": "object"
      },
      "summary": {
        "type": "object"
      }
    }
  }
}
