# Canonical repository text bytes for cross-platform evidence.
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Archive, database, and media artifacts are opaque bytes.
*.7z binary
*.db binary
*.gif binary
*.jpg binary
*.jpeg binary
*.png binary
*.sqlite binary
*.sqlite3 binary
*.webp binary
*.zip binary
