{
  "id": "workflow_decompose",
  "summary": "Turn a goal, task list, or workflow template into ordered task records.",
  "category": "memory-workflow",
  "authority": "Observe",
  "operates_on": "project",
  "invocation": {
    "interpreter": "${ROOT_VENV_PYTHON}",
    "entry": "tools/workflow_decompose/cli.py"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "goal": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "paths": {
        "type": "array"
      },
      "template": {
        "type": "string"
      },
      "template_path": {
        "type": "string"
      },
      "max_steps": {
        "type": "integer",
        "default": 8
      }
    }
  },
  "output_shape": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "steps": {
        "type": "array"
      },
      "playbook_skeleton": {
        "type": "array"
      },
      "summary": {
        "type": "object"
      }
    }
  }
}
