{
  "id": "git",
  "summary": "Git: init a repo, status, branch (with dirty state), stage an explicit approved set -> commit (-> pull --ff-only -> push).",
  "category": "git",
  "authority": "Apply",
  "operates_on": "project",
  "invocation": {
    "interpreter": "${ROOT_VENV_PYTHON}",
    "entry": "tools/git/cli.py"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "repo": {
        "type": "string",
        "description": "path to the repo (default: the project root)"
      },
      "action": {
        "type": "string",
        "enum": [
          "init",
          "status",
          "branch",
          "commit",
          "sync"
        ],
        "default": "status"
      },
      "message": {
        "type": "string",
        "description": "commit message (required for commit/sync)"
      },
      "allow_no_gitignore": {
        "type": "boolean",
        "description": "override the no-.gitignore safety gate"
      },
      "paths": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "the EXPLICIT approved working set to stage; omit to stage the whole tree with `add .`"
      },
      "pull": {
        "type": "boolean",
        "default": false,
        "description": "sync only: run `git pull --ff-only` BEFORE pushing"
      },
      "branch": {
        "type": "string",
        "description": "branch action: the branch to switch to"
      },
      "create": {
        "type": "boolean",
        "default": false,
        "description": "branch action: create it (checkout -b)"
      }
    }
  },
  "output_shape": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "action": {
        "type": "string"
      },
      "branch": {
        "type": "string"
      },
      "clean": {
        "type": "boolean"
      },
      "steps": {
        "type": "array"
      }
    }
  }
}
