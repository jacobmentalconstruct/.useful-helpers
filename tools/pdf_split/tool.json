{
  "id": "pdf_split",
  "summary": "Split a PDF into page-count chunks; dry-run-first and confirm-gated.",
  "category": "pdf",
  "authority": "Apply",
  "operates_on": "project",
  "invocation": {
    "interpreter": "${ROOT_VENV_PYTHON}",
    "entry": "tools/pdf_split/cli.py"
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "max_pages": {
        "type": "integer",
        "default": 10
      },
      "out_dir": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean",
        "default": true
      },
      "confirm": {
        "type": "boolean",
        "default": false
      },
      "password": {
        "type": "string"
      }
    },
    "required": [
      "path"
    ]
  },
  "output_shape": {
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "chunks": {
        "type": "array"
      },
      "summary": {
        "type": "object"
      }
    }
  }
}
